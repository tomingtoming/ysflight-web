{
  // Cloudflare Workers config.
  //
  // - Static game assets (dist/) are served by Workers Static Assets.
  // - worker/signal.js adds a tiny WebRTC signaling Worker at /signal, backed by
  //   a single Durable Object hub (SignalHub).  It replaces the old self-hosted
  //   server/signal.mjs.  Game traffic stays P2P (WebRTC DataChannel); only
  //   SDP/ICE setup messages pass through here.
  // - /turn mints short-lived Cloudflare Realtime TURN credentials (STUN + a TURN
  //   relay for NAT-blocked pairs).  It needs two secrets (NOT stored in this file):
  //     wrangler secret put TURN_KEY_ID       (Realtime TURN key id)
  //     wrangler secret put TURN_API_TOKEN    (that key's API token)
  //   Unconfigured -> /turn returns 204 and clients fall back to STUN-only.
  //   Hardened against abuse (relay traffic is metered): POST-only, same-origin
  //   Origin check, per-IP rate limit (TURN_RATE binding below), ttl 4h.
  //
  // The DO is declared as a SQLite-backed class (new_sqlite_classes), which is
  // available on the Workers Free plan.  It uses no storage (in-memory room
  // map), so it stays within the free tier.
  //
  // Build: scripts/build.sh produces dist/; Cloudflare runs `wrangler deploy`
  // (production) / `wrangler versions upload` (preview), uploading this Worker +
  // dist/ assets.  dist/_headers still applies.  Single-threaded build -> no
  // SharedArrayBuffer / COOP+COEP.
  "name": "ysflight-web",
  "compatibility_date": "2025-06-01",
  // Persist console logs (invocation + console.log) so pack-sync signaling can be
  // searched after the fact in the dashboard (Workers & Pages -> ysflight-web ->
  // Logs).  Only signaling control messages pass through this Worker -- game and
  // pack BYTES are P2P -- so log volume stays tiny and well within the free tier.
  "observability": { "enabled": true },
  // Preview URLs (per-version <VERSION_PREFIX>-ysflight-web.<subdomain>.workers.dev)
  // for `wrangler versions upload`.  Defaults to `workers_dev` (true here, since
  // no custom routes), so this is mostly explicit intent -- but without it a
  // dashboard toggle would silently flip the value on the next deploy.  Requires
  // a workers.dev subdomain registered on the account.
  "preview_urls": true,
  "main": "worker/signal.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SIGNAL", "class_name": "SignalHub" }
    ]
  },
  // Per-IP rate limit for /turn (worker/signal.js turnCredentials) via the
  // Workers Rate Limiting binding (open beta, available on the Free plan).
  // The client mints credentials once per page load, so 10/min/IP is generous
  // for legit players (even several behind one NAT) while cutting off
  // credential-harvesting loops -- TURN relay traffic is metered, so handing
  // out unlimited 4h credentials is a direct cost exposure.  namespace_id is
  // an arbitrary per-account label for this limiter, not a resource id.
  "unsafe": {
    "bindings": [
      {
        "name": "TURN_RATE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      // Per-IP rate limit for /metric (worker/signal.js metric).  A real visit
      // posts a handful of batches; 30/min/IP leaves room for a LAN party
      // behind one NAT while a script cannot burn the dataset's free-tier
      // write budget (100k data points/day) from one address.
      {
        "name": "METRIC_RATE",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },
  // Usage metrics (worker/signal.js /metric <- web/metrics.js): how many people
  // actually play, how long they fly, and whether they come back.  Analytics
  // Engine keeps three months and is read with SQL, which neither Web Analytics
  // (page views only) nor Workers Logs (7 days, no aggregation) can do.  Free
  // plan: 100,000 data points written per day, 10,000 read queries per day.
  // Reading needs no extra token: once Analytics Engine is enabled on the account,
  // wrangler's own OAuth token reaches the SQL API -- see docs/metrics.md.
  //
  // ROOM is a SECOND dataset on purpose.  ysfw_play counts visitors (index1 = a
  // browser); ysfw_room counts rooms (index1 = a room).  Merged, every
  // count(DISTINCT index1) already written against ysfw_play would count rooms as
  // people.  ysfw_room is what the signaling hub actually saw, which is the only
  // way to tell "nobody joined" from "the counter stops at the client".
  "analytics_engine_datasets": [
    { "binding": "PLAY", "dataset": "ysfw_play" },
    { "binding": "ROOM", "dataset": "ysfw_room" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalHub"] }
  ]
}
